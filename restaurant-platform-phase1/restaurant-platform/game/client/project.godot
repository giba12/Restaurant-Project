; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Restaurant Shift"
config/description="Version-2 game client for the restaurant platform: play a kitchen shift, and your actions flow through the same pipeline as the simulators."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5")

[display]

window/size/viewport_width=1024
window/size/viewport_height=680
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
