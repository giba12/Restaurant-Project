# Copy to .env to override -- every value here has a working default
# baked into docker-compose.yml, so this file is optional.

# Dev-only placeholder credentials. Unlike the k8s charts' values.yaml
# (which now refuses to ship a real-looking default at all -- see
# k8s/timescaledb/values.yaml), a fallback here is fine: Compose is a
# local, single-user demo the moment it starts, not a longer-lived,
# network-reachable deployment the way a k3s release is.
TIMESCALEDB_PASSWORD=changeme-local-dev-only
NARRATOR_PGPASSWORD=changeme-local-dev-only

# Shared secrets checked by dashboard-api/nginx and game-bridge (X-API-Key).
# See restaurant-platform-implementation-status.md for why these are treated
# differently from the Kubernetes charts' credentials (which refuse a real
# default entirely) -- this Compose path is a local, single-user demo.
DASHBOARD_API_KEY=changeme-local-dev-only
BRIDGE_API_KEY=changeme-local-dev-only

# Tiny, CPU-friendly model for the portable path (no GPU assumed). The
# k3s path uses qwen2.5:3b-instruct instead, running Ollama natively on
# the host for GPU access -- see restaurant-platform-project-notes.md.
OLLAMA_MODEL=qwen2.5:0.5b-instruct
